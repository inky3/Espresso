# Server-only secrets. Add these to your local .env.local and Vercel Environment Variables.
OPENROUTER_API_KEY=

# Rin private access
# Use a long, unique PIN. Do not prefix this with NEXT_PUBLIC_.
RIN_ACCESS_PIN=

# Generate with: openssl rand -base64 48
# Keep this secret private and identical across all deployed instances.
RIN_SESSION_SECRET=
