# Server-only secrets. Add these to your local .env.local and Vercel Environment Variables.
OPENROUTER_API_KEY=

# Rin private access
# Use a long, unique PIN. Do not prefix this with NEXT_PUBLIC_.
RIN_ACCESS_PIN=

# Generate with: openssl rand -base64 48
# Keep this secret private and identical across all deployed instances.
RIN_SESSION_SECRET=

# Owner access: comma-separated Google account emails allowed to use Espresso and Rin.
# Everyone else (including anonymous visitors) is refused by every API route.
OWNER_EMAILS=

# Optional: OpenRouter model ID for Rin's chat (defaults to deepseek/deepseek-v4.1-flash-1017, falls back to qwen/qwen3.8-27b).
RIN_MODEL=
